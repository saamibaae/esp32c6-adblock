#pragma once

// =====================================================
// Copy this file to include/secrets.h and fill in
// your own values. secrets.h is listed in .gitignore
// and will never be committed.
// =====================================================

// Wi-Fi credentials
#define WIFI_SSID     "YourNetworkName"
#define WIFI_PASSWORD "YourWiFiPassword"

// ArduinoOTA — used for wireless firmware updates
#define OTA_HOSTNAME  "dns-sinkhole"
#define OTA_PASSWORD  "changeme"

// Static IP — must match your router's subnet
// Common subnets: 192.168.0.x  or  192.168.1.x
#define STATIC_IP   "192.168.0.247"
#define GATEWAY_IP  "192.168.0.1"
#define SUBNET_MASK "255.255.255.0"
